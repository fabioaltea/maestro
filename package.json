{
  "name": "maestro-orchestrator",
  "version": "0.1.0",
  "description": "Local CLI orchestrator for AI agents that build software collaboratively",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "maestro": "./bin/maestro"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "scripts/postinstall.js",
    "vscode-extension/dist/*.vsix",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:vsix": "cd vscode-extension && npm install --no-audit --no-fund && npm run compile && npx --yes @vscode/vsce package --out dist/ --skip-license",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run build:vsix",
    "postinstall": "node scripts/postinstall.js || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "better-sqlite3": "^11.5.0",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
