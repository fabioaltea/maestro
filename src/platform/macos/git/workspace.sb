(version 1)
(deny default)

(allow process-fork)
(allow process-exec (literal (param "EXECUTABLE")))
(allow sysctl-read)
(allow file-read-metadata)
(allow file-read-data
  (literal "/")
  (subpath "/usr")
  (subpath "/System")
  (subpath "/Library/Developer")
  (subpath "/Applications/Xcode.app")
  (literal "/dev/null")
  (literal "/dev/random")
  (literal "/dev/urandom")
  (subpath (param "REFERENCE"))
  (subpath (param "COMMON"))
  (subpath (param "ADMIN"))
  (subpath (param "WORKTREE")))
(allow file-write-data (literal "/dev/null"))
(allow file-write*
  (literal (param "REF"))
  (literal (param "REF_LOCK"))
  (literal (param "REF_HEADS"))
  (literal (param "REF_MAESTRO"))
  (literal (param "REF_FEATURE"))
  (literal (param "REF_FEATURE_ID"))
  (literal (param "WORKTREES"))
  (subpath (param "WORKTREE_ADMIN"))
  (subpath (param "WORKTREE")))
