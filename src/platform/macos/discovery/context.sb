(version 1)
(deny default)
(allow process-exec (literal (param "EXECUTABLE")))
(allow file-read-metadata)
(allow file-read-data
  (literal "/")
  (subpath "/usr") (subpath "/System")
  (literal (param "EXECUTABLE")) (subpath (param "CODE")) (literal (param "PACKAGE"))
  (subpath (param "ROOT"))
  (literal "/dev/null") (literal "/dev/random") (literal "/dev/urandom"))
(deny file-read-data
  (regex #"/[.](git|ssh|aws|codex|claude|gnupg)(/|$)")
  (regex #"/[.][eE][nN][vV][^/]*($|/)")
  (subpath (param "EX1")) (subpath (param "EX2"))
  (subpath (param "EX3")) (subpath (param "EX4"))
  (subpath (param "EX5")) (subpath (param "EX6"))
  (subpath (param "EX7")) (subpath (param "EX8"))
  (subpath (param "EX9")) (subpath (param "EX10"))
  (subpath (param "EX11")) (subpath (param "EX12"))
  (subpath (param "EX13")) (subpath (param "EX14"))
  (subpath (param "EX15")) (subpath (param "EX16")))
(allow file-write-data (literal "/dev/null"))
(allow sysctl-read)
; No writes, network, process-fork, helpers or credential reads.
